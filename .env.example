# ── Groq (LLM) ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
MODEL_NAME=llama-3.3-70b-versatile

# ── Embeddings (FastEmbed — local, no API key needed) ────────────────────────
# Available models: https://qdrant.github.io/fastembed/examples/Supported_Models/
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Cloud (Neon, Supabase, etc.) — set DATABASE_URL and leave individual fields blank
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local — set individual fields
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aurynix
POSTGRES_USER=aurynix
POSTGRES_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────────────────────
# Cloud (Upstash, Redis Cloud) — set REDIS_URL (rediss:// for TLS)
# REDIS_URL=rediss://default:password@host:6379
# Local — set individual fields
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Cloud (Qdrant Cloud) — set QDRANT_URL + QDRANT_API_KEY
# QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key
# Local — set individual fields
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aurynix_docs

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Phase 2: Web Search ──────────────────────────────────────────────────────
# Get a free key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── Phase 2: Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_CHAT=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_DOCUMENTS=30
RATE_LIMIT_DEFAULT=60

# ── Phase 2: Google OAuth ────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com, enable Gmail + Calendar APIs
# OAuth 2.0 Client ID (type: Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/settings?oauth=success

# ── Phase 2: Observability ───────────────────────────────────────────────────
# OTLP collector (e.g. http://otel-collector:4317 for gRPC)
OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
